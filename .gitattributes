# Keep source and hash-pinned research artifacts byte-identical on all platforms.
.gitattributes text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Do not apply text conversion to binary research artifacts.
*.pdf binary
*.png binary
